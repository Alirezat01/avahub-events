// ═══════════════════════════════════════════════════════════════
// AVAHUB EVENTS — Phase 1 Database Schema (PostgreSQL / Supabase)
// ۸ جدول: profiles, categories, events, campaigns, registrations,
//         waitlists, checkins, admins
// ⭐ نیازمندی کلیدی کاربر: استخراج شماره موبایل‌ها از پنل ادمین
//    → profiles.phone یکتا + ایندکس + آماده خروجی CSV/Excel
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum EventStatus {
  DRAFT      /// پیش‌نویس — فقط ادمین می‌بیند
  PUBLISHED  /// منتشر شده — در سایت نمایش داده می‌شود
  CANCELLED  /// لغو شده
  ARCHIVED   /// آرشیو — بدون حذف داده‌ها
}

enum RegistrationStatus {
  PENDING    /// ثبت‌نام شده، در انتظار تأیید ایمیل
  CONFIRMED  /// تأیید شده — QR Pass صادر می‌شود
  CANCELLED  /// لغو شده توسط کاربر یا ادمین
}

enum WaitlistStatus {
  ACTIVE     /// در صف انتظار
  PROMOTED   /// ارتقا یافته به ثبت‌نام (جای خالی باز شد)
  CANCELLED  /// انصراف از صف
}

enum CheckinMethod {
  QR_CODE  /// اسکن QR در ورودی
  MANUAL   /// تیک دستی توسط ادمین
}

enum AdminRole {
  SUPER_ADMIN   /// دسترسی کامل — کاربر اصلی
  EVENT_MANAGER /// مدیریت رویدادها و ثبت‌نامی‌ها
  STAFF         /// فقط چک‌این
}

// ─────────────────────── 1. profiles (کاربران) ───────────────────────
// ⭐ قلب دیتابیس مخاطبان — فیلد phone یکتا برای استخراج از پنل ادمین

model Profile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId      String?   @unique @db.Uuid /// اتصال به Supabase Auth (فاز ۲)
  fullName        String?
  email           String    @unique
  phone           String?   @unique /// ⭐ شماره موبایل — مهم‌ترین فیلد برای کاربر
  phoneVerifiedAt DateTime? /// تأیید شماره (فازهای بعد)
  city            String?   /// برای تفکیک جغرافیایی مخاطبان
  birthYear       Int?      /// برای گروه‌بندی سنی
  interests       String[]  @default([]) /// دسته‌های علاقه‌مندی برای تارگتینگ
  firstSource     String?   /// اولین منبع ورود (UTM) — شناخت کانال جذب
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  registrations Registration[]
  waitlists     Waitlist[]
  adminRecord   Admin?

  @@map("profiles")
}

// ─────────────────────── 2. categories ───────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events Event[]

  @@map("categories")
}

// ─────────────────────── 3. events ───────────────────────
// رویدادها هرگز Hard-Delete نمی‌شوند (status = ARCHIVED) تا داده مخاطبان حفظ شود

model Event {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String      @unique
  title           String
  summary         String?     /// توضیح کوتاه برای کارت رویداد
  description     String?     /// توضیح کامل صفحه رویداد
  coverImage      String?     /// مسیر کاور (Media Manager ادمین)
  categoryId      Int?
  startsAt        DateTime
  endsAt          DateTime?
  venueName       String?
  venueAddress    String?
  venueCity       String      @default("تهران")
  capacity        Int         @default(0) /// ۰ = بدون محدودیت
  waitlistEnabled Boolean     @default(true) /// لیست انتظار خودکار
  isFeatured      Boolean     @default(false) /// نمایش ویژه در صفحه اصلی
  /// ── توضیحات خاص رویداد (ادمین می‌نویسد، کاربر موقع ثبت‌نام می‌بیند) ──
  hasSeating      Boolean?    /// null = اهمیتی ندارد | false = صندلی ندارد (نشستن آزاد)
  cateringNote    String?     /// وضعیت پذیرایی — مثال: «پذیرایی رایگان دارد» یا «ندارد»
  musicInfo       String?     /// نوع موسیقی اجرا شده (در صورت وجود)
  specialNotes    String?     /// نکات خاص دیگر برای نمایش به کاربر
  status          EventStatus @default(DRAFT)
  metaTitle       String?     /// SEO — title اختصاصی
  metaDescription String?     /// SEO — description اختصاصی
  /// ── فاز E — انعطاف اسکیمای رویداد ──
  eventType       String?     /// MUSIC | CONFERENCE | WORKSHOP | SEMINAR | CEREMONY | SPORT | EXHIBITION | OTHER — برای نوع Schema گوگل
  isOnline        Boolean     @default(false) /// رویداد آنلاین — Schema با VirtualLocation
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  category      Category?      @relation(fields: [categoryId], references: [id])
  registrations Registration[]
  waitlists     Waitlist[]
  eventAdmins   EventAdmin[]

  @@index([status, startsAt]) /// کوئری اصلی سایت: رویدادهای منتشرشده آینده
  @@index([categoryId])
  @@map("events")
}

// ─────────────────────── 4. campaigns (کمپین‌های UTM) ───────────────────────

model Campaign {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   /// نام فارسی کمپین
  source      String   /// instagram / telegram / google / qr / partner / direct
  medium      String?  /// post / story / cpc / banner ...
  utmCampaign String?  /// مقدار utm_campaign
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  registrations Registration[]

  @@index([source])
  @@map("campaigns")
}

// ─────────────────────── 5. registrations (ثبت حضور) ───────────────────────
// ⭐ برای استخراج شماره‌ها: JOIN با profiles (relation مستقیم)

model Registration {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String             @db.Uuid
  profileId   String             @db.Uuid
  campaignId  String?            @db.Uuid /// کدام کمپین این ثبت‌نام را آورد
  status      RegistrationStatus @default(PENDING)
  utmSource   String?            /// اسنپ‌شات UTM هنگام ثبت‌نام
  utmMedium   String?
  utmCampaign String?
  notes       String?            /// یادداشت ادمین
  /// ── پشتوانه حقوقی توافق‌نامه (فاز ۴) ──
  consentVersion   String?   /// نسخه متن توافق‌نامه پذیرفته‌شده — مثال: v1-1405
  consentAcceptedAt DateTime? /// زمان دقیق تیک زدن توافق‌نامه
  /// ── انصراف ──
  cancelledBy String?          /// USER / ADMIN — چه کسی لغو کرد
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())

  event    Event     @relation(fields: [eventId], references: [id])
  profile  Profile   @relation(fields: [profileId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  checkin  Checkin?

  @@unique([eventId, profileId]) /// هر کاربر فقط یک ثبت‌نام در هر رویداد
  @@index([eventId, status])     /// پنل ادمین: ثبت‌نامی‌های یک رویداد
  @@index([profileId])
  @@index([createdAt])           /// گزارش‌های زمانی
  @@map("registrations")
}

// ─────────────────────── 6. waitlists (لیست انتظار) ───────────────────────

model Waitlist {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String         @db.Uuid
  profileId  String         @db.Uuid
  position   Int            /// نوبت در صف
  status     WaitlistStatus @default(ACTIVE)
  notifiedAt DateTime?      /// کی خبر شد جای خالی باز شده
  createdAt  DateTime       @default(now())

  event   Event   @relation(fields: [eventId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])

  @@unique([eventId, profileId])
  @@index([eventId, status])
  @@map("waitlists")
}

// ─────────────────────── 7. checkins (چک‌این) ───────────────────────

model Checkin {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String        @unique @db.Uuid /// هر ثبت‌نام فقط یک چک‌این
  method         CheckinMethod @default(QR_CODE)
  checkedInAt    DateTime      @default(now()) /// ⭐ زمان ورود — برای گزارش‌ها
  checkedByAdmin String?       @db.Uuid /// کدام ادمین چک‌این کرد
  notes          String?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([checkedInAt])
  @@map("checkins")
}

// ─────────────────────── 8. admins ───────────────────────

model Admin {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String    @unique @db.Uuid
  role      AdminRole @default(STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  profile     Profile      @relation(fields: [profileId], references: [id])
  eventAdmins EventAdmin[]

  @@map("admins")
}

// فاز K — تخصیص رویداد به مدیر (دسترسی رویدادی)
// مدیر رویداد فقط آمار/مشخصات رویدادهای تخصیص‌یافته را می‌بیند
model EventAdmin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([adminId, eventId])
  @@map("event_admins")
}

// ─────────────────────────── Enums فاز ۶ ───────────────────────────

enum PostStatus {
  DRAFT      /// پیش‌نویس — فقط ادمین می‌بیند
  PUBLISHED  /// منتشر شده — در مجله نمایش داده می‌شود
}

// ─────────────────────── 9. journal_posts (مجله آواهاب) ───────────────────────
// فاز ۶ — موتور مجله: ادمین می‌نویسد، سایت منتشر می‌کند

model JournalPost {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String     @unique
  title           String
  excerpt         String?    /// خلاصهٔ کارت مجله
  content         String     @default("") /// متن مقاله (Markdown)
  coverImage      String?    /// کاور (URL از Media Manager)
  icon            String?    /// ایموجی کاور جایگزین (وقتی عکس نیست)
  gradient        String?    /// کلاس گرادیان کاور جایگزین
  tags            String[]   @default([])
  category        String?    /// فاز E — دستهٔ مقاله: رویدادها | برندسازی | تولید محتوا | تبلیغات
  isFeatured      Boolean    @default(false) /// فاز E — مقالهٔ ویژه بالای مجله
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?  /// تاریخ انتشار (نمایش عمومی)
  authorName      String?
  metaTitle       String?    /// SEO
  metaDescription String?    /// SEO
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  @@index([status, publishedAt])
  @@map("journal_posts")
}

// ─────────────────────── 10. portfolio_items (نمونه‌کارها) ───────────────────────
// فاز ۶ — نمونه‌کارهای واقعی با عکس، از پنل مدیریت

model PortfolioItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  tag         String?  /// برچسب روی عکس — مثل «همایش»
  description String?  /// توضیح اختیاری
  coverImage  String   /// عکس (URL از Media Manager)
  link        String?  /// لینک اختیاری (اینستاگرام/گزارش رویداد)
  sortOrder   Int      @default(0) /// ترتیب نمایش — کوچک‌تر اول
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  /// ── فاز E — Case Study + سئو ──
  slug            String?   @unique /// آدرس صفحهٔ کیس‌استادی /portfolio/[slug]
  client          String?   /// نام کارفرما/برند
  projectType     String?   /// همایش | کنسرت | برندینگ | کمپین و…
  projectDate     String?   /// مثلاً «پاییز ۱۴۰۳»
  servicesUsed    String[]  @default([]) /// خدمات انجام‌شده روی این پروژه
  results         String?   /// نتایج پروژه — چند خط
  gallery         String[]  @default([]) /// گالری چندتصویری
  isFeatured      Boolean   @default(false) /// نمایش ویژه بالای صفحهٔ پورتفولیو
  seoTitle        String?   /// SEO — title اختصاصی
  seoDescription  String?   /// SEO — description اختصاصی
  altText         String?   /// SEO — متن جایگزین تصویر کاور

  @@index([isActive, sortOrder])
  @@map("portfolio_items")
}

// ═══════════════ فاز G — CRM سبک، اعلان‌ها، ریدایرکت، لاگ ═══════════════

enum LeadStatus {
  NEW       /// سرنخ تازه — هنوز تماس گرفته نشده
  CONTACTED /// تماس اول انجام شد
  QUALIFIED /// مشتری بالقوه جدی
  WON       /// به پروژه تبدیل شد
  LOST      /// منصرف / بی‌پاسخ
}

model Lead {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String
  topic     String?    /// مشاوره رایگان | برگزاری رویداد | همکاری | …
  message   String     @default("")
  source    String     @default("contact") /// contact | whatsapp
  status    LeadStatus @default(NEW)
  adminNote String?    /// یادداشت داخلی ادمین
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@index([status, createdAt])
  @@map("leads")
}

model ActivityLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminProfileId String?  @db.Uuid /// null = اقدام از سمت عمومی (مثلاً فرم تماس)
  adminName      String?  /// اسنپ‌شات نام ادمین برای نمایش سریع
  action         String   /// LEAD_NEW | LEAD_STATUS | EVENT_CLONE | REDIRECT_SAVE | …
  entity         String   /// lead | event | redirect | journal | portfolio
  entityId       String?
  detail         String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

model Redirect {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromPath   String   @unique /// مسیر قدیمی — مثل /old-page
  toPath     String   /// مقصد — مسیر داخلی یا URL کامل
  statusCode Int      @default(301) /// 301 دائمی | 302 موقت
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("redirects")
}
